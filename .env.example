# Exact public HTTPS URL configured on your NAS reverse proxy, without trailing slash.
PUBLIC_ORIGIN=https://spese.example.com
# Long random value used only for the first administrator setup.
SETUP_KEY=replace-with-a-long-random-secret
HOST_PORT=3000
# For compose.portainer.yaml, set a versioned GHCR image tag.
IMAGE=ghcr.io/p4xx07/condivisa:v0.2.0
